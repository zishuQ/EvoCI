# EvoCI 本地运行配置
# 只使用 EVO_* 变量。修改后无需提交本文件。

# ---------------------------------------------------------------------------
# 模型接入
# 两份角色 Gateway 共用同一兼容接口与模型名，互不改写对方客户端。
# ---------------------------------------------------------------------------
# OpenAI 兼容接口的 base URL。
EVO_MODEL_BASE_URL=
# 接口密钥。不要写入文档、日志或提交到 git。
EVO_MODEL_API_KEY=
# 实际调用的模型名。Supervisor、Worker 与学习共用此名称。
EVO_MODEL_NAME=qwen3.8-27b

# ---------------------------------------------------------------------------
# 角色思考参数
# Consolidator / SkillMiner 复用 Worker 配置。
# ---------------------------------------------------------------------------
# Supervisor 是否请求 thinking。
EVO_SUPERVISOR_ENABLE_THINKING=1
# Supervisor 推理力度。规划与再规划使用 xhigh。
EVO_SUPERVISOR_REASONING_EFFORT=xhigh
# Worker 是否请求 thinking。调查、修复与学习共用。
EVO_WORKER_ENABLE_THINKING=1
# Worker 与学习（Memory Consolidator、SkillMiner）的推理力度。
EVO_WORKER_REASONING_EFFORT=medium

# ---------------------------------------------------------------------------
# 主管派发
# 一次 dispatch 只派一个任务；调查与修复都占用一次派发。
# ---------------------------------------------------------------------------
# Supervisor 最多派发次数。调查任务也占一次，默认 3。
EVO_MAX_SUPERVISOR_BATCHES=3

# ---------------------------------------------------------------------------
# 本地目录
# 相对路径相对项目根目录解析。
# ---------------------------------------------------------------------------
# 运行状态、事件、checkpoint 与 apply plan。
EVO_STATE_DIR=.evoci/state
# 隔离工作区。
EVO_WORKSPACE_DIR=.evoci/worktrees
# 仓库缓存。
EVO_REPO_CACHE_DIR=.evoci/repos
# Skill 包落盘目录。
EVO_CAPABILITY_DIR=.evoci/skills
# Skill 脚本运行时根目录。
EVO_RUNTIME_DIR=.evoci/runtime

# ---------------------------------------------------------------------------
# 调用次数、重试与超时
# 这些限制调用次数或墙钟时间，不是 token 硬预算。
# ---------------------------------------------------------------------------
# 单次 HTTP 模型请求的最大尝试次数（含网络重试），不是修复轮次。
EVO_MODEL_RETRY_ATTEMPTS=4
# 单次 Supervisor 或 Worker 最多进行多少轮模型行动。
# 最终结构化报告另保留一次模型调用，不计入这里。
EVO_MAX_LEAF_ITERATIONS=15
# 单次 Supervisor 或 Worker 最多执行多少次工具调用。
EVO_MAX_LEAF_TOOL_CALLS=30
# 整个任务允许的模型调用总数，包括 Supervisor、Worker 和收尾调用。
# 这是调用次数限制，不是 token 限制。
EVO_MAX_RUN_MODEL_CALLS=256
# 整个任务允许的工具调用总数。
EVO_MAX_RUN_TOOL_CALLS=320
# 仓库命令与正式验证的超时秒数。pytest / Docker 评测需要较长墙钟。
EVO_COMMAND_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Skill 目录摘要
# ---------------------------------------------------------------------------
# 交给 Supervisor 的 Skill 目录摘要字符预算。这不是任务 token 限制，也不向 Provider 发送输出上限。
EVO_SKILL_CATALOG_LIMIT_CHARS=8000
